{
  "name": "findmyteammate",
  "version": "1.0.0",
  "private": true,
  "description": "Find the right teammates for hackathons and competitions",
  "scripts": {
    "predev": "node scripts/set-db-provider.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/set-db-provider.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "predb:push": "node scripts/set-db-provider.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:studio": "prisma studio",
    "db:provider": "node scripts/set-db-provider.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "db:sql": "node scripts/generate-bootstrap-sql.mjs",
    "progress": "pandoc PROGRESS.md -o FindMyTeammate_Progress.docx --toc --toc-depth=2",
    "docs": "pandoc HOW-IT-WORKS.md -o FindMyTeammate_HowItWorks.docx --toc --toc-depth=2"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.3",
    "@types/nodemailer": "^8.0.2",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.1",
    "typescript": "5.9.3"
  }
}
