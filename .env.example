# ---------------------------------------------------------------------------
# Database
# Local development uses SQLite so the app runs with no external services.
# In production, point this at PostgreSQL (Neon / Supabase) and change the
# provider in prisma/schema.prisma to "postgresql".
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Session and one-time-code signing secret.
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="dev-secret-change-me-in-production-0123456789"

# Public base URL, used in email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SMTP — sends the six-digit codes for sign-up confirmation and password
# resets. Leave blank in development: codes are printed to the server console
# (and shown on the verification screen) instead of being emailed.
#
# Gmail / Google Workspace example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=<16-character Google app password, not your login password>
#   SMTP_FROM="FindMyTeammate <your.address@gmail.com>"
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---------------------------------------------------------------------------
# Demo data
# The seed gives every demo account this password, and the sign-in screen
# lists a few accounts to try. Turn this off before deploying.
# ---------------------------------------------------------------------------
ALLOW_DEMO_LOGIN="true"
DEMO_PASSWORD="Amrita@2026"
