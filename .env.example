# ---------------------------------------------------------------------------
# Database
# Local development uses SQLite so the app runs with no external services.
# In production, point this at PostgreSQL (Neon / Supabase) and change the
# provider in prisma/schema.prisma to "postgresql".
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Session signing secret. Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="dev-secret-change-me-in-production-0123456789"

# Public base URL, used for OAuth callbacks and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth providers (optional in development).
# Leave these blank to use the local demo sign-in on /login.
# GitHub callback URL:  http://localhost:3000/api/auth/callback/github
# Google callback URL:  http://localhost:3000/api/auth/callback/google
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Allow the seeded demo accounts to sign in without OAuth. Never enable this
# in production.
# ---------------------------------------------------------------------------
ALLOW_DEMO_LOGIN="true"
