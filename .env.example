# ---------------------------------------------------------------------------
# Database
#
# DATABASE_PROVIDER selects the Prisma datasource provider. A script rewrites
# prisma/schema.prisma to match before dev, build and db:push, because Prisma
# does not accept env() for `provider`.
#
#   sqlite      → local development, no services needed
#   postgresql  → production (Neon, Supabase, or your own Postgres)
# ---------------------------------------------------------------------------
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Postgres example:
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Session and one-time-code signing secret. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="dev-secret-change-me-in-production-0123456789"

# Public base URL, used in email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email — sends the six-digit codes for sign-up and password resets.
#
# ONE OF THESE IS REQUIRED IN PRODUCTION. The development fallback that prints
# codes to the console is switched off when NODE_ENV=production, so with no
# email transport nobody can complete registration.
#
# Option 1 (recommended on Vercel): Resend's HTTP API. Serverless functions
# handle an HTTP call far better than holding an SMTP connection open.
# Sign up at resend.com, create an API key, and use their onboarding sender
# until your own domain is verified.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="FindMyTeammate <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Option 2: SMTP. Good on a long-running server, or if you already have a
# mailbox rather than an email provider.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=<16-character app password, not your login password>
#   SMTP_FROM="FindMyTeammate <your.address@gmail.com>"
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---------------------------------------------------------------------------
# Skill checks — judging provider
#
# Judging runs on TypeSafe System One. You send the question and answer as
# state plus typed questions, and get calibrated probabilities and confidence
# back in one request — no JSON to recover from prose, no self-reported
# numbers. Leave the key blank and the feature does not appear.
#
# The questions themselves need no model: System One answers questions about
# text but does not write text, so they are written by hand per skill
# category in src/lib/services/skill-questions.ts.
#
# Key from https://console.typesafe.ai/keys
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=""
TYPESAFE_MODEL="jev-latest"
TYPESAFE_TIMEOUT_MS="30000"
TYPESAFE_RETRIES="2"

# ---------------------------------------------------------------------------
# One-time-code send limits, per network (on top of the 60-second per-address
# cooldown, which is not configurable).
#
# Deliberately generous: on campus wifi every student shares one public IP, so
# a tight limit locks out a whole classroom during a sign-up drive. The
# per-address cooldown is what stops someone hammering one mailbox; these stop
# a script walking through thousands of addresses and burning the mail quota.
# ---------------------------------------------------------------------------
OTP_IP_LIMIT_HOUR="20"
OTP_IP_LIMIT_DAY="60"
OTP_IP_EMAILS_DAY="40"

# ---------------------------------------------------------------------------
# Scheduled jobs. Set a secret to enable /api/cron/* ; leave blank and those
# endpoints refuse to run.
#   openssl rand -hex 24
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Demo data. Lists a few seeded accounts and their shared password on the
# sign-in page. MUST be false in production.
# ---------------------------------------------------------------------------
ALLOW_DEMO_LOGIN="true"
DEMO_PASSWORD="Amrita@2026"
