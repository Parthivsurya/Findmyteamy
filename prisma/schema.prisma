// FindMyTeammate — database schema
//
// Local development runs on SQLite so the project works with no external
// services. To deploy on PostgreSQL (Neon / Supabase), change the provider
// below to "postgresql" and point DATABASE_URL at the connection string.
//
// Note: SQLite does not support native enums or Json columns, so enum-valued
// fields are stored as String and validated through the union types in
// src/lib/enums.ts (which are also the Zod schemas used by every API route).
// On PostgreSQL these can become real `enum` blocks without touching app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users and accounts
// ---------------------------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  name     String
  username String  @unique
  email    String  @unique // Amrita student address; never exposed publicly
  image    String?
  bio      String? // max 300 chars, enforced by Zod
  college  String?
  location String?

  // --- authentication ------------------------------------------------------
  // Passwords are scrypt hashes (see src/lib/password.ts). Sign-in is refused
  // until the address has been confirmed with an emailed one-time code.
  passwordHash    String?
  emailVerifiedAt DateTime?

  // Brute-force protection: consecutive failures lock the account briefly.
  // Stored on the row rather than in memory so the limit holds across
  // serverless instances and restarts.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // --- academic identity, derived from the Amrita email --------------------
  // cb.sc.u4cse24535@cb.students.amrita.edu
  //  ^campus ^school ^programme ^branch ^joining year + roll
  // Stored as codes so that "same branch" and "same year" search stays exact;
  // the human labels live in src/lib/amrita.ts.
  campusCode   String?
  schoolCode   String?
  programCode  String? // "u4", "p2" …
  programYears Int?
  branchCode   String?
  joiningYear  Int?
  rollNumber   String?

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  /// Stored in international form without a plus, e.g. 919876543210, because
  /// that is the only shape wa.me accepts. Normalised on the way in so a
  /// number typed as "+91 98765 43210" still produces a working link.
  whatsapp     String?
  resumeUrl    String?

  // Which links the user wants shown publicly
  showGithub    Boolean @default(true)
  showLinkedin  Boolean @default(true)
  showPortfolio Boolean @default(true)
  /// Visible by default, because the point of the site is getting teammates
  /// talking and a hidden-by-default number would almost never be turned on.
  /// The toggle is offered at sign-up rather than buried in settings, so the
  /// choice is made knowingly: a roll address is university-issued, a personal
  /// phone number is not.
  showWhatsapp  Boolean @default(true)

  // "OPEN" | "EVENTS_ONLY" | "NOT_AVAILABLE"
  availability          String   @default("OPEN")
  availabilityUpdatedAt DateTime @default(now())

  profileCompleteness Int     @default(0)
  role                String  @default("USER") // "USER" | "ADMIN"
  onboarded           Boolean @default(false)

  // True only for accounts created by `db:seed:demo`. The sign-in page lists
  // these as hints in development; real accounts must never be listed there.
  isDemo Boolean @default(false)

  emailOnRequests     Boolean @default(true)
  emailOnVerification Boolean @default(true)
  emailWeeklyDigest   Boolean @default(true)

  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts       Account[]
  skills         UserSkill[]
  assessments    SkillAssessment[]
  roles          UserRole[]
  achievements   Achievement[]
  participations EventParticipation[]
  notifications  Notification[]

  createdEvents  Event[]      @relation("EventCreator")
  ledTeams       Team[]       @relation("TeamLeader")
  filledSlots    TeamSlot[]   @relation("SlotFilledBy")
  sentRequests   TeamRequest[] @relation("RequestFrom")
  inboxRequests  TeamRequest[] @relation("RequestTo")

  reportsMade     Report[] @relation("Reporter")
  reportsAgainst  Report[] @relation("Reported")
  blocksMade      Block[]  @relation("Blocker")
  blockedBy       Block[]  @relation("Blocked")

  /// How this account got in: VOUCH | REQUEST | SEED. Kept as a column rather
  /// than derived from the Vouch table so a profile label needs no join, and
  /// so it survives the voucher deleting their account.
  joinedVia       String   @default("SEED")
  vouchesWritten  Vouch[]  @relation("Voucher")
  vouchesReceived Vouch[]  @relation("Subject")
  requestsDecided AccessRequest[] @relation("Decider")

  @@index([username])
  @@index([availability])
  @@index([lastActiveAt])
  // Backs the "same year" and "same branch" filters on the home page.
  @@index([branchCode])
  @@index([joiningYear])
  @@index([campusCode, branchCode, joiningYear])
  /// Vouching looks a student up by their full roll identity on every write.
  @@index([campusCode, schoolCode, branchCode, joiningYear, rollNumber])
}

/// One request for a one-time code, kept so the rate limiter can count a
/// sliding window per network and per address. Purged by the cleanup job.
model OtpRequestLog {
  id        String   @id @default(cuid())
  /// Client IP as seen by the proxy. "unknown" when no header is present.
  ip        String
  email     String
  purpose   String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

/// One-time codes emailed for sign-up confirmation and password resets.
model EmailOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String // the code itself is never stored
  purpose   String // SIGNUP | LOGIN | RESET
  expiresAt DateTime
  attempts  Int       @default(0)
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// Links a user to an OAuth provider identity (GitHub / Google).
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "github" | "google" | "demo"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Skills and roles (master tables, so "React" / "ReactJS" never diverge)
// ---------------------------------------------------------------------------

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String // FRONTEND | BACKEND | MOBILE | DATA_AI | DATABASE | CLOUD_DEVOPS | DESIGN | EMERGING | SOFT
  approved Boolean @default(true) // false while a user suggestion awaits review

  createdAt DateTime @default(now())

  users         UserSkill[]
  assessments   SkillAssessment[]
  requiredBySlots TeamSlot[] @relation("SlotRequiredSkills")

  @@index([category])
  @@index([approved])
}

model UserSkill {
  userId  String
  skillId String
  level   String @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | EXPERT

  // Result of the most recent assessment, if the student has taken one. Kept
  // alongside the self-declared level rather than replacing it, so a profile
  // can show both what was claimed and what was demonstrated.
  assessedLevel String?
  assessedAt    DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

/// One attempt at demonstrating a claimed skill: the question put to the
/// student, their answer, and the model's two judgements on it.
model SkillAssessment {
  id           String @id @default(cuid())
  userId       String
  skillId      String
  claimedLevel String

  question String
  answer   String

  /// Demonstrated level, which may differ from what was claimed.
  assessedLevel String?
  /// How sure the model is about that level, 0-100.
  confidence    Int?
  rationale     String?

  /// 0-100 estimate that the answer was machine-written. Deliberately stored
  /// as a signal for an admin to weigh, not used to auto-reject: LLM-based
  /// detection is unreliable on short technical answers and on non-native
  /// English, and a false positive wrongly penalises a real student.
  aiLikelihood Int?
  aiVerdict    String? // LIKELY_HUMAN | UNCERTAIN | LIKELY_AI
  aiSignals    String? // JSON array of what the model noticed

  /// Token counts from the judging request. Recorded because the provider has
  /// no account usage endpoint, so this is the only record of what was spent.
  inputTokens  Int?
  outputTokens Int?

  status String @default("PENDING") // PENDING | ASSESSED | FLAGGED | FAILED
  /// Set when the run could not complete, so the student sees why.
  error  String?
  model  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId, skillId])
  @@index([status])
  @@index([createdAt])
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  users UserRole[]
  slots TeamSlot[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Achievements and verification
// ---------------------------------------------------------------------------

model Achievement {
  id          String    @id @default(cuid())
  userId      String
  title       String
  eventName   String
  organizer   String?
  position    String // WINNER | RUNNER_UP | FINALIST | PARTICIPANT | OTHER
  date        DateTime
  description String?
  proofUrl    String?
  status      String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  organizer           String
  description         String?
  startDate           DateTime
  endDate             DateTime
  registrationDeadline DateTime?
  mode                String // ONLINE | OFFLINE | HYBRID
  location            String?
  minTeamSize         Int       @default(2)
  maxTeamSize         Int       @default(4)
  themes              String    @default("") // comma separated
  prize               String?
  registrationLink    String?
  bannerUrl           String?
  status              String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdById         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy      User?                @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participations EventParticipation[]
  teams          Team[]

  @@index([status, startDate])
  @@index([slug])
}

model EventParticipation {
  userId    String
  eventId   String
  status    String   @default("LOOKING_FOR_TEAM") // LOOKING_FOR_TEAM | IN_TEAM | TEAM_LOOKING_FOR_MEMBERS
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId, status])
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id         String  @id @default(cuid())
  name       String
  idea       String?
  eventId    String
  leaderId   String
  isComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader   User          @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  slots    TeamSlot[]
  requests TeamRequest[]

  /// Endorsements that cite this team as the shared work.
  vouches  Vouch[]

  @@index([eventId, isComplete])
  @@index([leaderId])
}

model TeamSlot {
  id         String  @id @default(cuid())
  teamId     String
  roleId     String
  filledById String?
  note       String?

  createdAt DateTime @default(now())

  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id])
  filledBy       User?         @relation("SlotFilledBy", fields: [filledById], references: [id], onDelete: SetNull)
  requiredSkills Skill[]       @relation("SlotRequiredSkills")
  requests       TeamRequest[]

  @@index([teamId])
  @@index([filledById])
}

model TeamRequest {
  id         String  @id @default(cuid())
  type       String // INVITE | JOIN_REQUEST
  teamId     String
  slotId     String?
  fromUserId String
  toUserId   String
  message    String?
  status     String  @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED | EXPIRED

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slot     TeamSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  fromUser User      @relation("RequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User      @relation("RequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([teamId, status])
}

// ---------------------------------------------------------------------------
// Notifications and moderation
// ---------------------------------------------------------------------------

model Notification {
  id     String  @id @default(cuid())
  userId String
  type   String // INVITE | JOIN_REQUEST | REQUEST_ACCEPTED | REQUEST_DECLINED | ACHIEVEMENT_VERIFIED | ACHIEVEMENT_REJECTED | EVENT_SOON | AVAILABILITY_REMINDER
  title  String
  body   String?
  href   String?
  data   String  @default("{}") // JSON payload
  read   Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Report {
  id             String @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  status         String @default("OPEN") // OPEN | RESOLVED

  createdAt DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Getting in
// ---------------------------------------------------------------------------

/**
 * A vouch: one member names another student by roll number, says why, and gets
 * a link only that student can redeem.
 *
 * The link carries no secret worth guessing, because the binding below is what
 * secures it: redemption parses the signing-up address and every identity part
 * must match. A link shared in a group or screenshotted is useless to anyone
 * else, which is why there is no single-use or short-expiry requirement for
 * safety. Expiry exists only so dead links do not accumulate.
 *
 * `statement` is the whole point. An earlier design inherited a trust score
 * down a tree of vouches; that measured friendship, and compounded its own
 * error at every hop. A sentence a reader can weigh is better than a number
 * they cannot inspect.
 */
model Vouch {
  id      String @id @default(cuid())
  token   String @unique

  /// MEMBER is one student vouching another, and needs a statement.
  /// ADMIN_SEED is an admin planting a founding member: the ticket still
  /// records which admin created it, for audit, but the account it creates is
  /// a root of the forest rather than that admin's child. Without this the
  /// first cohort would all hang off one administrator and the tree would say
  /// something untrue about who brought whom in.
  kind String @default("MEMBER") // MEMBER | ADMIN_SEED

  /// Who created the ticket: the vouching student, or the admin for a seed.
  voucherId String
  /// Null until redeemed, because the subject has no account yet.
  subjectId String?

  /// The bound identity, read from a roll like "cse24535" plus the voucher's
  /// own campus and school. Stored in full even though the short form is what
  /// gets typed, because a roll number is only unique within these.
  campusCode  String
  schoolCode  String
  branchCode  String
  joiningYear Int
  rollNumber  String

  /// Why the voucher is vouching. Required for MEMBER and enforced in the
  /// service rather than the column, because an ADMIN_SEED has nothing
  /// truthful to say here and a placeholder sentence would read as a real
  /// endorsement to anyone looking at the profile.
  statement String?

  /// Set only for the verified kind, where both people shared this team and
  /// the platform can confirm it rather than taking anyone's word.
  teamId String?

  status String @default("PENDING") // PENDING | REDEEMED | REVOKED | EXPIRED

  /// The subject can hide a statement written about them. Admins still see it.
  hiddenBySubject Boolean @default(false)

  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
  expiresAt  DateTime?

  /// Cascade on both sides. The statement is the voucher's own speech, so it
  /// goes when they leave; and nothing should outlive the person it describes.
  voucher User  @relation("Voucher", fields: [voucherId], references: [id], onDelete: Cascade)
  subject User? @relation("Subject", fields: [subjectId], references: [id], onDelete: Cascade)
  team    Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([campusCode, schoolCode, branchCode, joiningYear, rollNumber])
  @@index([subjectId])
  @@index([voucherId, status])
  @@index([status])
  @@index([kind, status])
}

/**
 * The way in for someone with no vouch link. Their Amrita address already
 * proves they are a student, so this is about accountability rather than
 * identity: an admin or a member approves, and the account records that route.
 *
 * Without this, invite-only would filter hardest against the students with the
 * most to gain. A first-year who knows nobody needs a teammate finder more
 * than a final-year who already has a team.
 */
model AccessRequest {
  id    String @id @default(cuid())
  email String

  /// Optional, and the only thing they can say for themselves.
  note String?

  status String @default("PENDING") // PENDING | APPROVED | DECLINED

  decidedById String?
  decidedAt   DateTime?
  /// Shown to the requester when declined, so a refusal is not silent.
  decisionNote String?

  createdAt DateTime @default(now())

  decidedBy User? @relation("Decider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}
